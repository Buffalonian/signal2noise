# LLM: auto = OpenAI if OPENAI_API_KEY is set, else Ollama (local)
LLM_PROVIDER=auto

# OpenAI (optional)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini

# Ollama (default when no OpenAI key) — run: ollama list
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen3:8b

# Force fixture-only demo (no LLM calls): DEMO_MODE=true

# Run history (JSON files under data/sessions/) — for compare & reload in UI
SESSIONS_ENABLED=true
SESSIONS_DIR=data/sessions

# SEC EDGAR cache (JSON per CIK) — reuse filings for comparison runs
SEC_CACHE_ENABLED=true
SEC_CACHE_DIR=data/sec_cache
SEC_CACHE_TTL_HOURS=24

SEC_USER_AGENT=SignalPathIntel/0.1 contact@example.com
SEC_BASE_URL=https://data.sec.gov
CLAIM_SUPPORT_THRESHOLD=0.75
